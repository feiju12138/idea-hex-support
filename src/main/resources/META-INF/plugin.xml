<idea-plugin>
    <resource-bundle>cn.fj.loli.hexsupport.HexEditorBundle</resource-bundle>

    <depends>com.intellij.modules.platform</depends>

    <extensionPoints>
        <extensionPoint name="binaryStructureProvider"
                        interface="cn.fj.loli.hexsupport.structure.BinaryStructureProvider"
                        dynamic="true"/>
    </extensionPoints>

    <extensions defaultExtensionNs="com.intellij">
        <fileType name="HEX" implementationClass="cn.fj.loli.hexsupport.HexFileType"
                  fieldName="INSTANCE"/>
        <fileEditorProvider implementation="cn.fj.loli.hexsupport.HexFileEditorProvider" fileType="HEX"/>
        <fileEditorProvider implementation="cn.fj.loli.hexsupport.HexSecondaryFileEditorProvider"/>
        <diff.DiffTool implementation="cn.fj.loli.hexsupport.HexDiffTool"/>
        <diff.DiffTool implementation="cn.fj.loli.hexsupport.HexUnifiedDiffTool"/>
        <toolWindow id="Hex History" anchor="right" factoryClass="cn.fj.loli.hexsupport.HexOperationHistoryToolWindowFactory"/>
        <toolWindow id="Binary Structure" anchor="bottom" icon="/icons/binaryStructure.svg"
                    factoryClass="cn.fj.loli.hexsupport.HexStructureToolWindowFactory"/>
        <applicationService serviceImplementation="cn.fj.loli.hexsupport.HexSupportSettings"/>
        <applicationService serviceImplementation="cn.fj.loli.hexsupport.DiffSelectionSynchronizer"/>
        <applicationConfigurable parentId="tools" instance="cn.fj.loli.hexsupport.HexSupportConfigurable"
                                 id="cn.fj.loli.hexsupport.settings" key="settings.displayName"/>
    </extensions>

</idea-plugin>
